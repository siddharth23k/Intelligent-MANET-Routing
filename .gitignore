# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
venv/
env/

# OS and editors
.DS_Store
.idea/
.vscode/

# Logs and capture files
*.log
*.pcap

# Raw NS-3 output and derived datasets: large, and reproducible from
# simulation/run_simulation.sh plus the pipeline.
data/raw/*.xml
data/raw/*.csv
data/processed/*.csv
data/processed/dataset_manifest.json

# Model artifacts: reproducible from pipeline/train_predictor.py and
# pipeline/train_sfrnnr_paper.py. Tracking them is what let the code and the
# shipped models drift apart.
*.pkl
*.keras
*.h5
*.joblib

# Generated results. results/smoke/ is committed on purpose so the output
# format is visible without running anything.
/results/*.csv
/results/*.json
/results/comparison_summary.md

# Provenance files are small and tracked deliberately: they record which split
# and which statistics produced the current artifacts.
!results/models/predictor_schema.json
!results/models/sfrnnr_meta.json
!results/models/feature_norm_stats.json
!results/models/run_split.json

# Scratch space for files retired by a cleanup.
_to_delete/
